# Dev image for both platforms: webpack --watch + nodemon, sources bind-mounted.
# Same host-daemon device model as the production Dockerfile.
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
        git adb python3 python3-venv make g++ ffmpeg ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY . .
RUN npm install && npm run setup:ios
EXPOSE 8000 8443
CMD ["npm", "run", "dev"]
