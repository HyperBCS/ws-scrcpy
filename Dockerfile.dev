# Dev image for both platforms: webpack --watch + nodemon, sources bind-mounted.
# Same host-daemon device model as the production Dockerfile.
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
        git adb python3 python3-dbus python3-gi python3-venv make g++ ffmpeg ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY python ./python
RUN npm run setup:ios
# .dockerignore keeps the adb key, the HTTPS key and local settings out of this layer.
COPY . .
# The server runs as `node`, not root (see config/docker-entrypoint.sh). webpack writes dist/.
RUN install -m 755 config/docker-entrypoint.sh /usr/local/bin/ws-scrcpy-entrypoint \
    && mkdir -p /app/dist /app/data && chown node:node /app/dist /app/data
EXPOSE 8000 8443
ENTRYPOINT ["ws-scrcpy-entrypoint"]
CMD ["npm", "run", "dev"]
