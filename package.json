{
    "name": "ws-scrcpy",
    "version": "0.9.0-dev",
    "description": "Web client for scrcpy and more",
    "scripts": {
        "clean": "npx rimraf dist",
        "dist:dev": "webpack --config webpack/ws-scrcpy.dev.ts --stats-error-details",
        "dist:prod": "webpack --config webpack/ws-scrcpy.prod.ts --stats-error-details",
        "dist": "npm run dist:prod",
        "start": "npm run dist && cd dist && npm start",
        "script:dist:start": "node ./index.js",
        "lint": "eslint src/",
        "format": "eslint src/ --fix",
        "test": "node --test scripts/test-server-regressions.js scripts/test-coredevice.js scripts/test-stream-lifecycle.js scripts/test-client-lifecycle.js scripts/test-audio-protocol.js scripts/test-audio-player.js scripts/test-video-bootstrap.js scripts/test-mse-idle.js scripts/test-passcode.js",
        "test:ux": "node scripts/e2e-ux.js",
        "test:pwa": "node scripts/e2e-pwa.js",
        "test:audio": "node scripts/e2e-audio.js",
        "test:audio-availability": "node scripts/e2e-audio-availability.js",
        "test:idle": "node scripts/e2e-idle-video.js",
        "test:settings": "node scripts/e2e-settings.js",
        "test:sheets": "node scripts/e2e-sheets.js",
        "test:switcher": "node scripts/e2e-switcher.js",
        "test:unlock": "node scripts/e2e-unlock.js",
        "test:tools": "node scripts/e2e-tools.js",
        "test:files": "node scripts/e2e-files.js",
        "test:files-device": "node scripts/e2e-files-device.js",
        "test:ios": "node scripts/test-coredevice.js",
        "test:ios-typing": "node scripts/e2e-ios-typing.js",
        "setup:ios": "python3 -m venv python/venv && python/venv/bin/pip install -r python/requirements.txt && npm run patch:ios",
        "patch:ios": "python/venv/bin/python python/patches/pymobiledevice3-raw-audio.py",
        "dev": "concurrently --kill-others --raw \"webpack --config webpack/ws-scrcpy.dev.ts --watch\" \"until [ -f dist/index.js ]; do echo 'Waiting for Webpack...'; sleep 2; done && nodemon -L --config nodemon.dev.json --exec \\\"node --enable-source-maps dist/index.js\\\"\"",
        "setup:https": "node scripts/setup-https.js",
        "start:https": "WS_SCRCPY_CONFIG=$PWD/config.https.yaml npm start"
    },
    "author": "Sergey Volkov <drauggres@gmail.com>",
    "license": "MIT",
    "dependencies": {
        "@dead50f7/adbkit": "^2.11.4",
        "@preact/signals": "^2.11.2",
        "buffer": "^6.0.3",
        "express": "^4.22.2",
        "node-mjpeg-proxy": "^0.3.2",
        "node-pty": "^1.0.0",
        "path-browserify": "^1.0.1",
        "portfinder": "^1.0.28",
        "preact": "^10.29.8",
        "tslib": "^2.8.1",
        "ws": "^8.18.0",
        "yaml": "^2.2.2"
    },
    "devDependencies": {
        "@dead50f7/generate-package-json-webpack-plugin": "^2.6.1",
        "@eslint/js": "^10.0.1",
        "@types/bluebird": "^3.5.42",
        "@types/express": "^4.17.13",
        "@types/node": "^24.13.4",
        "@types/webpack-node-externals": "^2.5.3",
        "@types/ws": "^8.18.1",
        "@xterm/addon-attach": "^0.11.0",
        "@xterm/addon-fit": "^0.10.0",
        "@xterm/xterm": "^5.5.0",
        "concurrently": "^9.2.1",
        "copy-webpack-plugin": "^14.0.0",
        "css-loader": "^7.1.5",
        "eslint": "^10.10.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "file-loader": "^6.2.0",
        "h264-converter": "^0.1.4",
        "html-webpack-plugin": "^5.5.0",
        "ifdef-loader": "^2.3.2",
        "mini-css-extract-plugin": "^2.6.1",
        "nodemon": "^3.1.9",
        "playwright": "^1.63.0",
        "prettier": "^3.9.6",
        "rimraf": "^6.1.3",
        "svg-inline-loader": "^0.8.2",
        "ts-loader": "^9.5.2",
        "ts-node": "^10.9.2",
        "typescript": "^5.8.2",
        "typescript-eslint": "^8.70.0",
        "webpack": "^5.109.2",
        "webpack-cli": "^6.0.1",
        "webpack-node-externals": "^3.0.0"
    }
}
